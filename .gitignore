.venv/
__pycache__/
*.pyc

# generated by stimuli/build.py (deterministic; hashes in stimuli/manifest.jsonl)
stimuli/images/
# staging dir used by stimuli/build.py; removed after each run, left only if the process is killed
stimuli/.build-*/
